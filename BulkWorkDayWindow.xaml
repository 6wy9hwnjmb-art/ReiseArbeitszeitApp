<Window x:Class="ReiseArbeitszeitApp.BulkWorkDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReiseArbeitszeitApp.Controls"
        Title="Zeitraum erfassen"
        Width="920" Height="730"
        MinWidth="780" MinHeight="590"
        Icon="Assets/app-icon.ico"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Zeitraum erfassen" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Mehrere Tage prüfen und gemeinsam speichern"
                       Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Von"/>
                    <controls:DarkDatePicker x:Name="StartDatePicker"
                                             SelectedDateChanged="PreviewInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Bis einschließlich"/>
                    <controls:DarkDatePicker x:Name="EndDatePicker"
                                             SelectedDateChanged="PreviewInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Tagesart"/>
                    <ComboBox x:Name="DayTypeCombo"
                              SelectionChanged="PreviewInput_Changed"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,2,0,0">
                    <CheckBox x:Name="SkipWeekendsCheck"
                              Content="Wochenenden überspringen"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,24,0"
                              Checked="PreviewInput_Changed"
                              Unchecked="PreviewInput_Changed"/>
                    <TextBlock x:Name="HolidayRegionText"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </WrapPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Margin="0,14,0,0">
                    <TextBlock Text="Gemeinsame Notiz (optional)"/>
                    <TextBox x:Name="NoteBox"
                             Height="54"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Vorschau" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PreviewSummaryText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource CardBrush2}"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="SaveableCountText"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </Grid>

                <DataGrid Grid.Row="1"
                          x:Name="PreviewGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="31"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="110"/>
                        <DataGridTextColumn Header="Wochentag" Binding="{Binding WeekdayText}" Width="120"/>
                        <DataGridTextColumn Header="Tagesart" Binding="{Binding DayTypeText}" Width="130"/>
                        <DataGridTemplateColumn Header="Ergebnis" Width="*" MinWidth="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProtectionHintText"
                       Text="Vorhandene Einträge werden nicht überschrieben."
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Abbrechen"
                    Background="{StaticResource CardBrush2}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    Click="Cancel_Click"/>
            <Button Grid.Column="2"
                    x:Name="SaveButton"
                    Content="Ausgewählte Tage speichern"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
