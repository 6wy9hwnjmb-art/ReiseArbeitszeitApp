<Window x:Class="ReiseArbeitszeitApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReiseArbeitszeitApp.Controls"
        Title="Reise- &amp; Arbeitszeitrechner" Height="820" Width="1180"
        MinHeight="720" MinWidth="1050"
        Icon="Assets/app-icon.ico"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Reise- &amp; Arbeitszeitrechner" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Berechnung von Reisezeit, Zeitverschiebung, Arbeitszeit und Überstunden"
                       Foreground="{StaticResource MutedBrush}" FontSize="15"/>
            <TextBlock x:Name="AppVersionText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" FontSize="14">
            <TabItem Header="Reisezeit">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="TripFormTitleText" Text="Reise erfassen" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Startort"/>
                                <TextBox x:Name="DepartureLocationBox" Text="Frankfurt" LostFocus="DepartureLocationBox_LostFocus"/>
                                <TextBlock Text="Zielort"/>
                                <TextBox x:Name="ArrivalLocationBox" Text="New York" LostFocus="ArrivalLocationBox_LostFocus"/>

                                <TextBlock Text="Abflugdatum"/>
                                <controls:DarkDatePicker x:Name="DepartureDatePicker"/>
                                <TextBlock Text="Abflugzeit HH:mm"/>
                                <controls:DarkTimePicker x:Name="DepartureTimeBox" Text="14:30" MaxHour="23"/>

                                <TextBlock Text="Ankunftsdatum am Zielort"/>
                                <controls:DarkDatePicker x:Name="ArrivalDatePicker"/>
                                <TextBlock Text="Ankunftszeit am Zielort HH:mm"/>
                                <controls:DarkTimePicker x:Name="ArrivalTimeBox" Text="18:00" MaxHour="23"/>

                                <TextBlock Text="Start-Zeitzone"/>
                                <ComboBox x:Name="DepartureTimeZoneCombo" IsTextSearchEnabled="True"/>
                                <TextBlock x:Name="DepartureTimeZoneHintText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,-8,0,12"/>
                                <TextBlock Text="Ziel-Zeitzone"/>
                                <ComboBox x:Name="ArrivalTimeZoneCombo" IsTextSearchEnabled="True"/>
                                <TextBlock x:Name="ArrivalTimeZoneHintText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,-8,0,12"/>

                                <TextBlock Text="Notiz"/>
                                <TextBox x:Name="TripNoteBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                                <WrapPanel>
                                    <Button Content="Berechnen" Click="CalculateTrip_Click"/>
                                    <Button x:Name="SaveTripButton" Content="Berechnen &amp; speichern" Click="SaveTrip_Click"/>
                                    <Button Content="Neu" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="NewTrip_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ergebnis" Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Row="1" Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="TripResultText" Text="Noch keine Berechnung durchgeführt." FontSize="17" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TripUtcText" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel Grid.Row="2" Margin="0,0,0,14">
                                <Button Content="Als Arbeitstag übernehmen" Click="UseTripAsWorkDay_Click"/>
                                <Button Content="Auswahl bearbeiten" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="EditSelectedTrip_Click"/>
                                <Button Content="Auswahl löschen" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="DeleteSelectedTrip_Click"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="3" x:Name="TripsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="TripsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Abflug" Binding="{Binding DepartureText}" Width="140"/>
                                    <DataGridTextColumn Header="Von" Binding="{Binding DepartureLocation}" Width="120"/>
                                    <DataGridTextColumn Header="Nach" Binding="{Binding ArrivalLocation}" Width="120"/>
                                    <DataGridTextColumn Header="Ankunft" Binding="{Binding ArrivalText}" Width="140"/>
                                    <DataGridTextColumn Header="Reisezeit" Binding="{Binding TravelTimeText}" Width="120"/>
                                    <DataGridTextColumn Header="Zeitdiff." Binding="{Binding TimeDifferenceText}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Arbeitszeit">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="WorkFormTitleText" Text="Arbeitstag erfassen" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Datum"/>
                                <controls:DarkDatePicker x:Name="WorkDatePicker"/>
                                <WrapPanel Margin="0,-4,0,10">
                                    <Button Content="Heute" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="SetWorkDateToday_Click"/>
                                    <Button Content="Gestern" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="SetWorkDateYesterday_Click"/>
                                    <Button Content="Standardtag speichern" Click="SaveStandardWorkDay_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Beginn HH:mm"/>
                                <controls:DarkTimePicker x:Name="WorkStartBox" Text="07:00" MaxHour="23"/>
                                <TextBlock Text="Ende HH:mm"/>
                                <controls:DarkTimePicker x:Name="WorkEndBox" Text="16:00" MaxHour="23"/>
                                <TextBlock Text="Pause HH:mm"/>
                                <controls:DarkTimePicker x:Name="BreakBox" Text="00:30" MaxHour="24"/>
                                <TextBlock Text="Sollzeit HH:mm"/>
                                <controls:DarkTimePicker x:Name="TargetBox" Text="08:00" MaxHour="24"/>
                                <CheckBox x:Name="IsTravelDayCheck" Content="Reisetag" Foreground="{StaticResource TextBrush}" Margin="0,4,0,10"/>
                                <TextBlock Text="angerechnete Reisezeit HH:mm"/>
                                <controls:DarkTimePicker x:Name="TravelWorkTimeBox" Text="00:00" MaxHour="72"/>
                                <TextBlock Text="Ort / Einsatzort"/>
                                <TextBox x:Name="WorkLocationBox" Text=""/>
                                <TextBlock Text="Notiz"/>
                                <TextBox x:Name="WorkNoteBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>
                                <WrapPanel>
                                    <Button Content="Arbeitszeit prüfen" Click="PreviewWorkDay_Click"/>
                                    <Button x:Name="SaveWorkDayButton" Content="Speichern" Click="SaveWorkDay_Click"/>
                                    <Button Content="Neu" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="NewWorkDay_Click"/>
                                </WrapPanel>
                                <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                    <TextBlock x:Name="WorkPreviewText" Text="Vorschau: noch keine Berechnung." TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Gespeicherte Arbeitstage" Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Row="1" Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="WorkDashboardTitleText" Text="Aktueller Monat" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Tage" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="WorkDashboardDaysText" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Ist" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="WorkDashboardActualText" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Soll" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="WorkDashboardTargetText" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Saldo" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="WorkDashboardOvertimeText" FontSize="22" FontWeight="Bold"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <WrapPanel Grid.Row="2" Margin="0,0,0,14">
                                <Button Content="Auswahl bearbeiten" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="EditSelectedWorkDay_Click"/>
                                <Button Content="Auswahl löschen" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="DeleteSelectedWorkDay_Click"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="3" x:Name="WorkDaysGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="WorkDaysGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="100"/>
                                    <DataGridTextColumn Header="Beginn" Binding="{Binding StartTimeText}" Width="80"/>
                                    <DataGridTextColumn Header="Ende" Binding="{Binding EndTimeText}" Width="80"/>
                                    <DataGridTextColumn Header="Pause" Binding="{Binding BreakTimeText}" Width="80"/>
                                    <DataGridTextColumn Header="Ist" Binding="{Binding ActualWorkTimeText}" Width="80"/>
                                    <DataGridTextColumn Header="Soll" Binding="{Binding TargetTimeText}" Width="80"/>
                                    <DataGridTextColumn Header="Überstunden" Binding="{Binding OvertimeText}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding Overtime, Converter={StaticResource OvertimeBrushConverter}}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Reisezeit" Binding="{Binding TravelWorkTimeText}" Width="95"/>
                                    <DataGridCheckBoxColumn Header="Reise" Binding="{Binding IsTravelDay}" Width="65"/>
                                    <DataGridTextColumn Header="Ort" Binding="{Binding Location}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Auswertung">
                <Grid Margin="0,16,0,0">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Auswertung" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Jahr" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="ReportYearBox" Width="90" Text="2026" Margin="0,0,12,0"/>
                                    <TextBlock Text="Monat" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="ReportMonthCombo" Width="140" Margin="0,0,12,0"/>
                                    <Button Content="Auswertung aktualisieren" Click="RefreshReport_Click"/>
                                    <Button Content="Jahr als CSV" Click="ExportCsv_Click"/>
                                    <Button Content="Monat als CSV" Click="ExportMonthCsv_Click"/>
                                </WrapPanel>

                                <TextBlock Text="Monatsübersicht" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,12"/>
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Arbeitstage" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="MonthWorkDaysText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Istzeit" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="MonthActualText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Sollzeit" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="MonthTargetText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Überstunden" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="MonthOvertimeText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock x:Name="MonthDetailsText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

                                <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,24,0,20"/>

                                <TextBlock Text="Jahresübersicht" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Arbeitstage" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ReportWorkDaysText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Gesamtarbeitszeit" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ReportActualText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="Sollarbeitszeit" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ReportTargetText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Überstunden" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="ReportOvertimeText" FontSize="26" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock x:Name="ReportDetailsText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <Grid Margin="0,16,0,0">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="8" Padding="24" MaxWidth="620" HorizontalAlignment="Left">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Einstellungen" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="Standard-Startort"/>
                                <TextBox x:Name="SettingsDefaultDepartureLocationBox"/>

                                <TextBlock Text="Standard-Arbeitsbeginn HH:mm"/>
                                <controls:DarkTimePicker x:Name="SettingsDefaultWorkStartBox" MaxHour="23"/>

                                <TextBlock Text="Standard-Arbeitsende HH:mm"/>
                                <controls:DarkTimePicker x:Name="SettingsDefaultWorkEndBox" MaxHour="23"/>

                                <TextBlock Text="Standard-Pause HH:mm"/>
                                <controls:DarkTimePicker x:Name="SettingsDefaultBreakBox" MaxHour="24"/>

                                <TextBlock Text="Standard-Sollzeit HH:mm"/>
                                <controls:DarkTimePicker x:Name="SettingsDefaultTargetBox" MaxHour="24"/>

                                <TextBlock Text="CSV-Exportordner"/>
                                <TextBox x:Name="SettingsCsvExportFolderBox"/>

                                <CheckBox x:Name="SettingsCheckUpdatesBox"
                                          Content="Beim Start automatisch nach Updates suchen"
                                          Margin="0,4,0,8"/>

                                <WrapPanel>
                                    <Button Content="Einstellungen speichern" Click="SaveSettings_Click"/>
                                    <Button Content="Standardwerte anwenden" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="ApplySettingsDefaults_Click"/>
                                    <Button Content="Datenbank sichern" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="BackupDatabase_Click"/>
                                    <Button Content="Nach Updates suchen" Background="{StaticResource CardBrush2}" BorderBrush="{StaticResource BorderBrushSoft}" Click="CheckForUpdates_Click"/>
                                </WrapPanel>

                                <Border Background="{StaticResource CardBrush2}" CornerRadius="8" Padding="14" Margin="0,18,0,0">
                                    <TextBlock x:Name="SettingsInfoText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
    </Grid>
</Window>
