<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ReiseArbeitszeitApp</AssemblyName>
    <RootNamespace>ReiseArbeitszeitApp</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Product>Reise- und Arbeitszeitrechner</Product>
    <Company>Sebe</Company>
    <Copyright>Copyright (c) Sebe 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>
</Project>
